# Admin credentials for dashboard access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Security token secret for session signing
TOKEN_SECRET=your_security_token_secret_here

# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=your_google_analytics_measurement_id_here

# SMTP Settings for Gmail (Google App Password)
# 1) Turn ON 2-Step Verification: Google Account > Security > 2-Step Verification
# 2) Generate App Password: Google Account > Security > 2-Step Verification > App Passwords
# 3) Do NOT use quotes or spaces in passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_google_app_password
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_TO=imrankhang3920@gmail.com
CONTACT_EMAIL=imrankhang3920@gmail.com

